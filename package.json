{
  "name": "opc-workbench",
  "version": "0.1.0",
  "description": "Local orchestration and agent workbench powered by Pi",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "opc-workbench": "bin/opc-workbench.mjs"
  },
  "files": [
    "bin",
    "build",
    "web/dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "start": "node bin/opc-workbench.mjs",
    "prepack": "npm run check && npm run build && npm run check:standalone",
    "check:standalone": "node scripts/check-standalone.mjs",
    "check:current-docs": "node scripts/check-current-docs.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@earendil-works/pi-ai": "0.80.3",
    "typebox": "1.1.38",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "marked": "18.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
